{
  "name": "@k-leumas/queque-cli",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.7.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-leumas/queque.git"
  },
  "files": [
    "dist",
    "shell",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "qq": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/cli/main.ts --watch",
    "dev:restart": "node scripts/restart-dev-server.mjs",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint --edit",
    "prepare": "[ -d .git ] && lefthook install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.92.0",
    "cac": "7.0.0",
    "ink": "7.1.1",
    "react": "19.2.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.2",
    "@vitest/coverage-v8": "4.0.4",
    "lefthook": "^1.13.6",
    "semantic-release": "^25.0.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.0.4"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
