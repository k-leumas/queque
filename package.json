{
  "name": "@k-leumas/queque-cli",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.11.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-leumas/queque.git"
  },
  "files": [
    "dist",
    "shell",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "qq": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/cli/main.ts --watch",
    "dev:restart": "node scripts/restart-dev-server.mjs",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint --edit",
    "smoke:distro": "scripts/smoke-distro.sh",
    "test:distro": "scripts/ci/test-in-distro.sh",
    "prepare": "[ -d .git ] && lefthook install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "cac": "7.0.0",
    "ink": "7.1.1",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.2",
    "@vitest/coverage-v8": "4.1.12",
    "lefthook": "^1.13.6",
    "semantic-release": "^25.0.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
