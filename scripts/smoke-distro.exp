#!/usr/bin/expect -f
# PTY driver for scripts/smoke-distro-runner.sh. Usage: expect smoke-distro.exp PASS [SHELL]
#
# SHELL is `zsh` (the default) or `bash`. Types `??` into a real interactive shell (the
# installed zsh ZLE widget or bash readline adapter, `qq client`, the daemon and the Ink TUI)
# and proves the buffer state by EXECUTING it:
#   accept: `list files??`, Enter on row 1, Enter again runs it (the shell reports tldr
#           missing: zsh `command not found: tldr`, bash `tldr: command not found`)
#   Esc:    `echo restored-$((6*7))??`, Esc, Enter prints restored-42; only the restored
#           buffer can print 42, since the typed line holds `$((6*7))`
# Every step after the TUI opens is anchored on the shell prompt redraw (`QQSMOKE% ...` for
# zsh, `QQSMOKE$ ...` for bash), never on text the TUI itself printed: that raced and lost
# keystrokes in the research prototype. Esc is sent only after a candidate row is on screen
# (Esc during the pre-candidate `thinking…` leaves the client running).
#
# Passes (zsh runs all three; the runner requests only `default` for bash):
#   default    XDG_RUNTIME_DIR unset (the socket is /tmp/qq-UID.sock by design)
#   c-locale   LANG=C LC_ALL=C; non-ASCII glyphs render as `?`, so assert behaviour only
#   consent    QQ_SMOKE_CONSENT=1 (the runner's ~/.zshrc then leaves QQ_TELEMETRY unset):
#              the first accept shows the D-09 question `[y/N]`, `n` answers it, and the
#              accepted buffer must still reach the prompt and execute; a second accept
#              must reach the redraw without the question. The runner then checks that
#              config.json holds the no. Failures: exit 17 when the question never shows,
#              exit 18 when it shows a second time.
# The default and c-locale passes run with QQ_TELEMETRY=0: the question text starts with
# `QueQue: `, so it would trip the error pattern there (16).
# Logs: /out/pty-PASS.log for zsh, /out/pty-bash-PASS.log for bash.
#
# Exit codes: 10 first prompt, 11 no candidate row, 12 accept redraw, 13 executed buffer,
# 14 Esc redraw, 15 restored buffer did not run, 16 QueQue error text, 17 no consent
# question, 18 consent asked twice, 19 unknown pass or shell.

set pass [lindex $argv 0]
set shell [lindex $argv 1]
if {$shell eq ""} {
  set shell zsh
}
set timeout 40
log_user 1
# An idle prompt: zsh ends it with control sequences (ESC[K, bracketed paste ESC[?2004h,
# and on Debian keypad transmit mode ESC[?1h ESC=), so a bare `QQSMOKE% $` never matches.
# `%`/`#` is the zsh prompt (`%#`), `$` the bash one (`\$`).
set prompt_idle {QQSMOKE[%#$] (?:\x1b\[[0-9;?]*[A-Za-z]|\x1b[=>])*$}
set queque_error {(queque|QueQue): [^\r\n]*}

proc fail {code message} {
  puts stderr "\nsmoke-distro.exp: $message (exit $code)"
  exit $code
}

# Waits for a candidate row after `??`, failing on QueQue error text.
proc wait_for_candidate {} {
  global queque_error
  expect {
    -re $queque_error { fail 16 "QueQue printed an error: $expect_out(0,string)" }
    "tldr z3" {}
    timeout { fail 11 "timed out waiting for the candidate row tldr z3" }
    eof { fail 11 "the shell exited before the candidate row appeared" }
  }
}

# Waits for the shell to report the accepted `tldr z3` missing (it ran from the buffer).
proc wait_for_not_found {message} {
  expect {
    "command not found: tldr" {}
    "tldr: command not found" {}
    timeout { fail 13 $message }
    eof { fail 13 "the shell exited before the accepted buffer ran" }
  }
}

if {$shell eq "zsh"} {
  set log_name pty-$pass.log
} elseif {$shell eq "bash"} {
  set log_name pty-bash-$pass.log
} else {
  fail 19 "unknown shell: $shell"
}

# Not a Tcl `switch`: its `default` pattern would swallow every pass name.
if {$pass eq "default"} {
  log_file -noappend /out/$log_name
  spawn env -u XDG_RUNTIME_DIR TERM=xterm-256color $shell -i
} elseif {$pass eq "c-locale"} {
  log_file -noappend /out/$log_name
  spawn env LANG=C LC_ALL=C TERM=xterm-256color $shell -i
} elseif {$pass eq "consent"} {
  log_file -noappend /out/$log_name
  spawn env QQ_SMOKE_CONSENT=1 TERM=xterm-256color $shell -i
} else {
  fail 19 "unknown pass: $pass"
}

expect {
  -re $prompt_idle {}
  timeout { fail 10 "timed out waiting for the first $shell prompt" }
  eof { fail 10 "$shell exited before the first prompt" }
}

if {$pass eq "consent"} {
  # First accept: the question shows after the result is written (D-09). No error
  # pattern here: the question itself starts with `QueQue: `.
  send -- "list files??"
  wait_for_candidate
  send -- "\r"
  expect {
    -re {\[y/N\]} {}
    -re {QQSMOKE[%#$] tldr z3  # } { fail 17 "the accept redrew the prompt without the consent question" }
    timeout { fail 17 "timed out waiting for the consent question" }
    eof { fail 17 "the shell exited before the consent question appeared" }
  }
  send -- "n"
  expect {
    -re {QQSMOKE[%#$] tldr z3  # } {}
    -re $queque_error { fail 16 "QueQue printed an error: $expect_out(0,string)" }
    timeout { fail 12 "timed out waiting for the prompt redraw after answering the question" }
    eof { fail 12 "the shell exited before the accepted command reached the buffer" }
  }
  send -- "\r"
  wait_for_not_found "the accepted buffer did not execute after the consent answer"
  expect {
    -re $prompt_idle {}
    timeout { fail 14 "timed out waiting for the prompt after the accepted command ran" }
    eof { fail 14 "the shell exited after the accepted command ran" }
  }

  # Second accept: answered once, never asked again.
  send -- "list files??"
  wait_for_candidate
  send -- "\r"
  expect {
    -re {\[y/N\]} { fail 18 "the consent question was asked a second time" }
    -re {QQSMOKE[%#$] tldr z3  # } {}
    -re $queque_error { fail 16 "QueQue printed an error: $expect_out(0,string)" }
    timeout { fail 12 "timed out waiting for the second accept's prompt redraw" }
    eof { fail 12 "the shell exited before the second accepted command reached the buffer" }
  }
  send -- "\r"
  wait_for_not_found "the second accepted buffer did not execute"
  expect -re $prompt_idle
  send -- "exit\r"
  expect eof
  exit 0
}

# Accept: Enter on row 1 fills the buffer.
send -- "list files??"
wait_for_candidate
send -- "\r"
expect {
  -re {QQSMOKE[%#$] tldr z3  # } {}
  -re $queque_error { fail 16 "QueQue printed an error: $expect_out(0,string)" }
  timeout { fail 12 "timed out waiting for the prompt redraw with the accepted command" }
  eof { fail 12 "the shell exited before the accepted command reached the buffer" }
}
send -- "\r"
wait_for_not_found "the accepted buffer did not execute ($shell never reported tldr missing)"

# Esc: the typed line comes back unchanged.
expect {
  -re $prompt_idle {}
  timeout { fail 14 "timed out waiting for the prompt after the accepted command ran" }
  eof { fail 14 "the shell exited after the accepted command ran" }
}
send -- {echo restored-$((6*7))??}
wait_for_candidate
send -- "\033"
expect {
  -re {QQSMOKE[%#$] echo restored-} {}
  -re $queque_error { fail 16 "QueQue printed an error: $expect_out(0,string)" }
  timeout { fail 14 "timed out waiting for the prompt redraw with the restored line" }
  eof { fail 14 "the shell exited before the line was restored" }
}
send -- "\r"
expect {
  "restored-42" {}
  timeout { fail 15 "the restored buffer did not run (no restored-42)" }
  eof { fail 15 "the shell exited before the restored buffer ran" }
}

expect -re $prompt_idle
send -- "exit\r"
expect eof
exit 0
