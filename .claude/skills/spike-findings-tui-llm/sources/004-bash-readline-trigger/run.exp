#!/usr/bin/expect -f
# Usage: run.exp <bash-binary> <case> <logfile>
set bash [lindex $argv 0]
set case [lindex $argv 1]
set log  [lindex $argv 2]
set timeout 5
set dir [file dirname [file normalize [info script]]]
set env(QQ_SPIKE_LOG) $log
set env(LANG) en_US.UTF-8
set env(LC_ALL) en_US.UTF-8
set env(PS1) {$ }
set env(INPUTRC) /dev/null
log_user 0
spawn -noecho $bash --noprofile --norc -i
expect {$ }
send "PS1='$ '; source $dir/spike.bash; echo __READY__\r"
expect -re {\n__READY__\r\n\$ }

proc type {s} { foreach c [split $s ""] { send -- $c; after 15 } }
proc run_and_capture {} {
  send "\r"; after 200
  send "echo __E''ND__\r"
  expect -re {(.*)[\r\n]__END__\r} { set o $expect_out(1,string) } timeout { return TIMEOUT }
  regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $o {} o
  regsub -all {\r} $o {} o
  regsub {\n?\$ echo __E''ND__\s*$} $o {} o
  return [string trim $o]
}

switch $case {
  emacs      { type "list files??" }
  single     { type "echo x?" }
  midline    { type "echo abcd"; send "\033\[D\033\[D"; after 50; type "??" }
  cafe       { type "echo café??" }
  emoji      { type "echo "; fconfigure $spawn_id -encoding binary
               send -- "\xf0\x9f\x9a\x80"; fconfigure $spawn_id -encoding utf-8; type "x??" }
  mb_mid     { type "echo café bar"; send "\033\[D\033\[D\033\[D\033\[D"; after 50; type "??" }
  vi         { send "set -o vi\r"; expect -re {\$ $}; type "list files??" }
  vi_cafe    { send "set -o vi\r"; expect -re {\$ $}; type "echo café??" }
  paste_on   { send "bind 'set enable-bracketed-paste on'\r"; expect -re {\$ $}
               send "\033\[200~echo pasted??\033\[201~"; after 100 }
  paste_off  { send "bind 'set enable-bracketed-paste off'\r"; expect -re {\$ $}
               send "echo pasted??"; after 100 }
}
after 100
puts "RAN: [run_and_capture]"
send "exit\r"
expect eof
